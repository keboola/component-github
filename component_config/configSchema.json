{
  "type": "object",
  "title": "GitHub Extractor — Root Configuration",
  "required": ["auth_type"],
  "properties": {
    "auth_type": {
      "type": "string",
      "title": "Authentication Method",
      "enum": ["pat", "oauth"],
      "options": {
        "enum_titles": ["Personal Access Token", "OAuth"]
      },
      "default": "pat",
      "propertyOrder": 10
    },
    "#github_token": {
      "type": "string",
      "title": "GitHub Personal Access Token",
      "format": "password",
      "description": "Your GitHub Personal Access Token.",
      "propertyOrder": 20,
      "options": {
        "tooltip": "Create a classic (`ghp_…`) or fine-grained (`github_pat_…`) PAT in **GitHub → Settings → Developer settings → Personal access tokens**. Required scopes: `read:org`, `repo`. If your organization enforces SAML SSO you must also SSO-authorize the token before use.",
        "dependencies": {
          "auth_type": ["pat"]
        }
      }
    },
    "test_connection": {
      "type": "button",
      "format": "test-connection",
      "propertyOrder": 25,
      "options": {
        "dependencies": {
          "auth_type": ["pat"]
        },
        "async": {
          "label": "Test Connection",
          "action": "testConnection"
        }
      }
    },
    "authorization": {
      "type": "object",
      "title": "GitHub OAuth",
      "propertyOrder": 30,
      "options": {
        "dependencies": {
          "auth_type": ["oauth"]
        }
      },
      "properties": {
        "oauth_api": {
          "type": "object",
          "title": "OAuth Credentials",
          "properties": {
            "id": {
              "type": "string",
              "title": "OAuth API ID"
            },
            "version": {
              "type": "integer",
              "title": "OAuth Version",
              "default": 3
            }
          }
        }
      }
    },
    "debug": {
      "type": "boolean",
      "title": "Debug Mode",
      "default": false,
      "propertyOrder": 1000
    }
  }
}
