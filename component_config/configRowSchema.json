{
  "type": "object",
  "title": "GitHub Extractor — Row Configuration",
  "required": ["endpoint"],
  "properties": {
    "endpoint": {
      "type": "string",
      "title": "Data Source",
      "enum": [
        "user",
        "user_repos",
        "user_orgs",
        "organizations",
        "organization_members",
        "organization_teams",
        "team_members",
        "organization_repositories",
        "organization_events",
        "organization_outside_collaborators",
        "repository",
        "repository_branches",
        "repository_tags",
        "repository_commits",
        "repository_contributors",
        "repository_collaborators",
        "repository_languages",
        "repository_topics",
        "repository_releases",
        "repository_issues",
        "repository_issue_comments",
        "repository_pulls",
        "repository_pull_reviews",
        "repository_pull_review_comments",
        "repository_labels",
        "repository_milestones",
        "repository_stargazers",
        "repository_subscribers",
        "repository_forks",
        "repository_workflows",
        "repository_workflow_runs",
        "repository_deployments",
        "repository_webhooks"
      ],
      "options": {
        "enum_titles": [
          "Authenticated User",
          "User Repositories",
          "User Organizations",
          "Organization",
          "Organization Members",
          "Organization Teams",
          "Team Members",
          "Organization Repositories",
          "Organization Events",
          "Organization Outside Collaborators",
          "Repository",
          "Repository Branches",
          "Repository Tags",
          "Repository Commits",
          "Repository Contributors",
          "Repository Collaborators",
          "Repository Languages",
          "Repository Topics",
          "Repository Releases",
          "Repository Issues",
          "Repository Issue Comments",
          "Repository Pull Requests",
          "Repository Pull Request Reviews",
          "Repository Pull Request Review Comments",
          "Repository Labels",
          "Repository Milestones",
          "Repository Stargazers",
          "Repository Subscribers",
          "Repository Forks",
          "Repository Workflows",
          "Repository Workflow Runs",
          "Repository Deployments",
          "Repository Webhooks"
        ]
      },
      "propertyOrder": 10
    },
    "organization": {
      "type": "array",
      "title": "Organizations",
      "format": "select",
      "uniqueItems": true,
      "default": [],
      "items": {
        "type": "string",
        "enum": []
      },
      "description": "Leave empty to include all organizations you belong to.",
      "propertyOrder": 20,
      "options": {
        "async": {
          "label": "Load Organizations",
          "action": "listOrganizations",
          "autoload": true
        },
        "tooltip": "Pick one or more organizations. Empty = all organizations your token can access. For repository data sources this also scopes which repositories are offered below.",
        "dependencies": {
          "endpoint": [
            "organizations",
            "organization_members",
            "organization_teams",
            "team_members",
            "organization_repositories",
            "organization_events",
            "organization_outside_collaborators",
            "repository",
            "repository_branches",
            "repository_tags",
            "repository_commits",
            "repository_contributors",
            "repository_collaborators",
            "repository_languages",
            "repository_topics",
            "repository_releases",
            "repository_issues",
            "repository_issue_comments",
            "repository_pulls",
            "repository_pull_reviews",
            "repository_pull_review_comments",
            "repository_labels",
            "repository_milestones",
            "repository_stargazers",
            "repository_subscribers",
            "repository_forks",
            "repository_workflows",
            "repository_workflow_runs",
            "repository_deployments",
            "repository_webhooks"
          ]
        }
      }
    },
    "team_slug": {
      "type": "array",
      "title": "Teams",
      "format": "select",
      "uniqueItems": true,
      "default": [],
      "items": {
        "type": "string",
        "enum": []
      },
      "description": "Leave empty to include all teams in the selected organization(s).",
      "propertyOrder": 30,
      "options": {
        "async": {
          "label": "Load Teams",
          "action": "listTeams",
          "autoload": ["organization"]
        },
        "tooltip": "Pick one or more teams. Empty = all teams in the selected organization(s).",
        "dependencies": {
          "endpoint": ["team_members"]
        }
      }
    },
    "repository": {
      "type": "array",
      "title": "Repositories",
      "format": "select",
      "uniqueItems": true,
      "default": [],
      "items": {
        "type": "string",
        "enum": []
      },
      "description": "Leave empty to include all repositories in the selected organization(s).",
      "propertyOrder": 40,
      "options": {
        "async": {
          "label": "Load Repositories",
          "action": "listRepositories",
          "autoload": ["organization", "endpoint"]
        },
        "tooltip": "Pick one or more repositories. Empty = all repositories in the selected organization(s), or all of your repositories if no organization is set.",
        "dependencies": {
          "endpoint": [
            "repository",
            "repository_branches",
            "repository_tags",
            "repository_commits",
            "repository_contributors",
            "repository_collaborators",
            "repository_languages",
            "repository_topics",
            "repository_releases",
            "repository_issues",
            "repository_issue_comments",
            "repository_pulls",
            "repository_pull_reviews",
            "repository_pull_review_comments",
            "repository_labels",
            "repository_milestones",
            "repository_stargazers",
            "repository_subscribers",
            "repository_forks",
            "repository_workflows",
            "repository_workflow_runs",
            "repository_deployments",
            "repository_webhooks"
          ]
        }
      }
    },
    "pull_number": {
      "type": "integer",
      "title": "Pull Request Number (optional)",
      "description": "Set to fetch reviews for one specific pull request; leave empty for all pull requests.",
      "propertyOrder": 50,
      "options": {
        "tooltip": "Targeted mode: with a number set, select exactly one repository and only that pull request's reviews are fetched. Leave empty to fetch reviews for every pull request in the selected repositories.",
        "dependencies": {
          "endpoint": ["repository_pull_reviews"]
        }
      }
    },
    "load_type": {
      "type": "string",
      "title": "Load Type (optional)",
      "enum": ["full_load", "incremental_load"],
      "options": {
        "enum_titles": ["Full Load", "Incremental Load"],
        "dependencies": {
          "endpoint": [
            "user_repos",
            "organization_repositories",
            "repository_commits",
            "repository_issues",
            "repository_issue_comments",
            "repository_pulls",
            "repository_pull_reviews",
            "repository_pull_review_comments",
            "repository_workflow_runs"
          ]
        }
      },
      "default": "incremental_load",
      "propertyOrder": 60
    },
    "initial_since": {
      "type": "string",
      "title": "Fetch Since (optional)",
      "default": "",
      "description": "Only fetch records changed at or after this point.",
      "propertyOrder": 70,
      "options": {
        "tooltip": "Accepts an ISO-8601 instant (<code>2024-01-01T00:00:00Z</code>) or a relative phrase (<code>5 days ago</code>, <code>yesterday</code>). In Full Load it is applied on every run (a rolling window — the table is replaced each run). In Incremental Load it is the starting point for the first run only, after which the stored watermark takes over. Empty = full history.",
        "dependencies": {
          "endpoint": [
            "user_repos",
            "organization_repositories",
            "repository_commits",
            "repository_issues",
            "repository_issue_comments",
            "repository_pulls",
            "repository_pull_reviews",
            "repository_pull_review_comments",
            "repository_workflow_runs"
          ]
        }
      }
    },
    "issue_state": {
      "type": "string",
      "title": "Issue State (optional)",
      "enum": ["all", "open", "closed"],
      "options": {
        "enum_titles": ["All", "Open", "Closed"],
        "dependencies": {
          "endpoint": ["repository_issues"]
        }
      },
      "default": "all",
      "propertyOrder": 80
    },
    "pull_state": {
      "type": "string",
      "title": "Pull Request State (optional)",
      "enum": ["all", "open", "closed"],
      "options": {
        "enum_titles": ["All", "Open", "Closed"],
        "dependencies": {
          "endpoint": ["repository_pulls"]
        }
      },
      "default": "all",
      "propertyOrder": 81
    },
    "milestone_state": {
      "type": "string",
      "title": "Milestone State (optional)",
      "enum": ["all", "open", "closed"],
      "options": {
        "enum_titles": ["All", "Open", "Closed"],
        "dependencies": {
          "endpoint": ["repository_milestones"]
        }
      },
      "default": "all",
      "propertyOrder": 82
    }
  }
}
